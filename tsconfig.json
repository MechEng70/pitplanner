{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "types": ["node", "jest"]
  },
  "include": [
    "app",
    "src",
    "engine",
    "app.config.ts",
    "app.config.test.ts",
    "jest.setup.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}
