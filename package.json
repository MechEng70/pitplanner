{
  "name": "pit-planner",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Pit Planner: cook-day scheduling for smokers and griddles (Android, Capacitor)",
  "scripts": {
    "test": "npm run test:engine && npm run test:ui",
    "test:engine": "node --test engine/*.test.ts",
    "test:ui": "vitest run",
    "test:android": "tools/test-android.sh",
    "test:all": "npm test && npm run test:android",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tools/check.sh",
    "snyk:monitor": "snyk monitor --all-projects --exclude=reference,release,dist",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "sync": "npm run build && cap sync android",
    "device": "tools/device/run.sh",
    "release": "tools/release.sh"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource/roboto": "^5.3.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^9.39.5",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.6",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "eslint-config-preact": "^2.0.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
