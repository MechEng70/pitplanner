{
  "name": "pit-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pit Planner: cook-day scheduling for smokers and griddles (Android, Capacitor)",
  "scripts": {
    "test": "node --test engine/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "sync": "npm run build && cap sync android",
    "device": "tools/device/run.sh",
    "release": "tools/release.sh"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource/roboto": "^5.3.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
