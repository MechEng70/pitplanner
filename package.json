{
  "name": "pit-planner",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Pit Planner: cook-day scheduling for smokers and griddles (Android, Expo + React Native)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "APP_VARIANT=development expo run:android",
    "test": "npm run test:engine && npm run test:gate && npm run test:app",
    "test:engine": "node --test engine/*.test.ts",
    "test:gate": "node --test tools/*.test.mjs",
    "test:app": "jest",
    "test:android": "tools/test-android.sh",
    "test:all": "npm test && npm run test:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tools/check.sh",
    "snyk:monitor": "snyk monitor --all-projects --exclude=reference,release,legacy,docs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "expo": "~58.0.24",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.19",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.10.1",
    "react-dom": "19.3.0",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
