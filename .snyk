# Snyk policy. Exclusions here are documented in docs/design/SECURITY-EXCEPTIONS.md.
version: v1.25.0
exclude:
  global:
    # SE-002: the old HTML planner kept for reference (SPEC header). Not built, not shipped.
    - reference/**
    # SE-002: design docs, mockup sources (.dc.html) and screenshots. Not built, not shipped.
    - docs/**
    # SE-002 (extended in T-002): the Capacitor app kept as reference until parity. Not built, not shipped.
    - legacy/**
    # Release artifacts: built from scanned sources.
    - release/**
ignore:
  # SE-003: build-machine dev tooling (Metro file watcher, React Native dev-middleware), not in the app
  # bundle. Path-specific so a new path into shipped code still fails the gate.
  SNYK-JS-BRACES-19963945:
    - 'react-native > @react-native/community-cli-plugin > metro > metro-file-map > micromatch > braces':
        reason: 'SE-003: Metro bundler file watcher, build machine only; no fixed braces release exists'
        expires: 2027-02-10T00:00:00.000Z
    - 'expo > @expo/cli > @expo/metro > metro > metro-file-map > micromatch > braces':
        reason: 'SE-003: Metro bundler file watcher, build machine only; no fixed braces release exists'
        expires: 2027-02-10T00:00:00.000Z
  SNYK-JS-OPEN-22112123:
    - 'expo > @expo/cli > @react-native/dev-middleware > open':
        reason: 'SE-003: dev server opens the debugger in a local browser, build machine only; fix is ESM-only open 11'
        expires: 2027-02-10T00:00:00.000Z
    - 'react-native > @react-native/community-cli-plugin > @react-native/dev-middleware > open':
        reason: 'SE-003: dev server opens the debugger in a local browser, build machine only; fix is ESM-only open 11'
        expires: 2027-02-10T00:00:00.000Z
