# Release signing (plugins/withReleaseSigning). Copy to keystore.properties at the repo root (git-ignored)
# and fill in the passwords. storeFile must be an absolute path (Gradle does not expand ~).
# Back up the .jks file and these passwords outside GitHub: losing them means every user has to uninstall
# to get an update.
storeFile=/home/you/keys/pitplanner.jks
storePassword=
keyAlias=
keyPassword=
